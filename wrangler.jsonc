{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bloodpressure",
	"main": "src/index.js",
	"compatibility_date": "2025-11-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		// 前端静态页面目录，由 Cloudflare 直接托管
		"directory": "./public",
		// 子路径形态（route: example.com/bloodpressure*）下首页不匹配任何 asset，
		// 由 Worker 通过该 binding 回退取根路径 index.html
		"binding": "ASSETS",
		// 不匹配 asset 的请求交给 Worker 的 fetch handler 处理（默认行为，显式声明）
		"not_found_handling": "none"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bloodpressure",
			"database_id": "aa69a861-5545-4bb0-91e8-071b1cb65bed"
		}
	]
}